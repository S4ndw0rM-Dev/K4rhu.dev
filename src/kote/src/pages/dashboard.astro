// Cálculo IVA en tiempo real
document.getElementById('monto-neto').addEventListener('input', e => {
  const neto  = parseFloat(e.target.value) || 0;
  const iva   = Math.round(neto * 0.19);
  const total = neto + iva;
  const f = n => '$' + n.toLocaleString('es-CL');
  document.getElementById('calc-neto').textContent  = f(neto);
  document.getElementById('calc-iva').textContent   = f(iva);
  document.getElementById('calc-total').textContent = f(total);
});

document.getElementById('form-factura').addEventListener('submit', e => {
  e.preventDefault();
  modalFactura.classList.add('hidden');

  // Notificar a InnovaBot
  window.dispatchEvent(new CustomEvent('innovabot:context', { detail: { section: 'facturas' } }));

  // Feedback visual
  const topbar = document.querySelector('header');
  const msg = document.createElement('div');
  msg.className = 'fixed top-4 right-4 bg-emerald-600 text-white px-5 py-3 rounded-xl shadow-xl z-50 text-sm font-medium animate-bounce-in';
  msg.textContent = '✅ Factura guardada y asiento generado automáticamente';
  document.body.appendChild(msg);
  setTimeout(() => msg.remove(), 3500);
});

