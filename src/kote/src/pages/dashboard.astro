/* ═══ NAVEGACIÓN MÓDULOS ═══ */
const navBtns = document.querySelectorAll('.nav-btn');
const modules = document.querySelectorAll('.module-content');
const pageTitle = document.getElementById('page-title');
const pageSub   = document.getElementById('page-sub');

const moduleMeta = {
  dashboard: { title: 'Dashboard',           sub: 'Resumen financiero · Mayo 2026' },
  facturas:  { title: 'Gestión de Facturas', sub: 'Período: Enero — Mayo 2026' },
  libro:     { title: 'Libro Mayor',         sub: 'Movimientos por cuenta contable' },
  balance:   { title: 'Balance General',     sub: 'Al 31 de Mayo de 2026' },
  asientos:  { title: 'Asientos Contables',  sub: 'Libro Diario · Mayo 2026' },
  informes:  { title: 'Informes Financieros', sub: 'Generados con IA' },
};

function activateModule(id) {
  // Mostrar módulo
  modules.forEach(m => m.classList.add('hidden'));
  const mod = document.getElementById('mod-' + id);
  if (mod) { mod.classList.remove('hidden'); mod.classList.add('animate-fade-up'); }

  // Actualizar nav
  navBtns.forEach(btn => {
    const active = btn.dataset.module === id;
    btn.classList.toggle('bg-indigo-600', active);
    btn.classList.toggle('text-white', active);
    btn.classList.toggle('text-slate-400', !active);
  });

  // Actualizar topbar
  const meta = moduleMeta[id] || {};
  if (pageTitle) pageTitle.textContent = meta.title || '';
  if (pageSub) pageSub.textContent = meta.sub || '';

  // Disparar evento para InnovaBot
  window.dispatchEvent(new CustomEvent('innovabot:context', { detail: { section: id } }));

  // Inicializar charts si corresponde
  if (id === 'dashboard') initChartMain();
  if (id === 'balance')   initChartBalance();
  if (id === 'informes')  initChartTendencia();
  if (id === 'libro')     renderMayor('caja');
}

navBtns.forEach(btn => {
  btn.addEventListener('click', () => activateModule(btn.dataset.module));
});

// Activar dashboard al cargar
activateModule('dashboard');

