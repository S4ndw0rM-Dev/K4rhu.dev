/* ═══ LIBRO MAYOR ═══ */
function fmt(n) {
  return n ? '$' + n.replace(/\B(?=(\d{3})+(?!\d))/g, '.') : '';
}

function renderMayor(cuentaId) {
  const data = MOVIMIENTOS[cuentaId];
  if (!data) return;

  document.getElementById('cuenta-nombre').textContent = data.nombre;
  document.getElementById('cuenta-saldo').querySelector('p:last-child').textContent = data.saldo;

  const tbody = document.getElementById('mayor-tbody');
  tbody.innerHTML = '';
  data.movs.forEach(m => {
    const tr = document.createElement('tr');
    tr.className = 'border-b border-slate-100 hover:bg-slate-50 transition-colors';
    tr.innerHTML = `
      <td class="px-5 py-3 text-xs text-slate-400">${m.fecha}/05/2026</td>
      <td class="px-5 py-3 text-sm text-slate-700">${m.desc}</td>
      <td class="px-5 py-3 text-right font-mono text-emerald-600 text-sm">${m.debe ? '$' + m.debe : ''}</td>
      <td class="px-5 py-3 text-right font-mono text-rose-500 text-sm">${m.haber ? '$' + m.haber : ''}</td>
      <td class="px-5 py-3 text-right font-mono text-indigo-600 font-semibold text-sm">$${m.saldo}</td>
    `;
    tbody.appendChild(tr);
  });

  document.getElementById('total-debe').textContent  = data.totalD;
  document.getElementById('total-haber').textContent = data.totalH;
  document.getElementById('saldo-final').textContent = data.saldoFinal;
}

document.getElementById('cuenta-selector').addEventListener('change', e => {
  renderMayor(e.target.value);
});

