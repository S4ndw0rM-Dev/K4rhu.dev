// Agregar línea de asiento
document.getElementById('add-linea').addEventListener('click', () => {
  const container = document.getElementById('lineas-asiento');
  const div = document.createElement('div');
  div.className = 'linea-asiento grid grid-cols-3 gap-2';
  div.innerHTML = `
    <input type="text" placeholder="Cuenta contable" class="border border-slate-300 rounded-lg px-2.5 py-2 text-xs focus:outline-none focus:border-indigo-500" />
    <input type="number" placeholder="0" class="debe-input border border-slate-300 rounded-lg px-2.5 py-2 text-xs focus:outline-none focus:border-emerald-500 text-right" />
    <input type="number" placeholder="0" class="haber-input border border-slate-300 rounded-lg px-2.5 py-2 text-xs focus:outline-none focus:border-rose-500 text-right" />
  `;
  container.appendChild(div);
  attachLineaListeners(div);
});

function calcTotales() {
  const debes  = [...document.querySelectorAll('.debe-input')].reduce((s, i) => s + (parseFloat(i.value) || 0), 0);
  const habers = [...document.querySelectorAll('.haber-input')].reduce((s, i) => s + (parseFloat(i.value) || 0), 0);
  const f = n => '$' + n.toLocaleString('es-CL');
  document.getElementById('total-debe-new').textContent  = f(debes);
  document.getElementById('total-haber-new').textContent = f(habers);

  const check = document.getElementById('balance-check');
  if (debes === 0 && habers === 0) {
    check.textContent = 'Ingresa los montos para verificar';
    check.className = 'mt-2 text-center text-xs font-medium text-slate-400 py-1';
  } else if (Math.abs(debes - habers) < 1) {
    check.textContent = '✅ Asiento balanceado — Debe = Haber';
    check.className = 'mt-2 text-center text-xs font-bold text-emerald-600 bg-emerald-50 rounded-lg py-1';
  } else {
    check.textContent = `⚠️ Diferencia: $${Math.abs(debes - habers).toLocaleString('es-CL')} — Debe = Haber para guardar`;
    check.className = 'mt-2 text-center text-xs font-bold text-rose-600 bg-rose-50 rounded-lg py-1';
  }
}

function attachLineaListeners(parent) {
  parent.querySelectorAll('input[type=number]').forEach(i => i.addEventListener('input', calcTotales));
}

document.querySelectorAll('.linea-asiento').forEach(attachLineaListeners);

document.getElementById('guardar-asiento').addEventListener('click', () => {
  const debes  = [...document.querySelectorAll('.debe-input')].reduce((s, i) => s + (parseFloat(i.value) || 0), 0);
  const habers = [...document.querySelectorAll('.haber-input')].reduce((s, i) => s + (parseFloat(i.value) || 0), 0);

  if (Math.abs(debes - habers) > 1) {
    alert('⚠️ El asiento no está balanceado. Debe = Haber para poder guardar.');
    return;
  }
  if (debes === 0) {
    alert('⚠️ Ingresa los montos del asiento primero.');
    return;
  }

  modalAsiento.classList.add('hidden');
  const msg = document.createElement('div');
  msg.className = 'fixed top-4 right-4 bg-emerald-600 text-white px-5 py-3 rounded-xl shadow-xl z-50 text-sm font-medium animate-bounce-in';
  msg.textContent = '✅ Asiento #0127 guardado en el Libro Diario';
  document.body.appendChild(msg);
  setTimeout(() => msg.remove(), 3500);
});
