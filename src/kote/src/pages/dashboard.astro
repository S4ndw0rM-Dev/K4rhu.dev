---
import '../styles/global.css';
import InnovaBot from '../components/InnovaBot.astro';
---

<!doctype html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <link rel="icon" type="image/svg+xml" href="/innovaconta/favicon.svg" />
  <title>Dashboard | Innovaconta</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet" />
  <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.4/dist/chart.umd.min.js"></script>
</head>
<body class="bg-slate-50 font-[Inter,system-ui,sans-serif] text-slate-800">

<!-- ── LAYOUT ── -->
<div class="flex h-screen overflow-hidden">

  <!-- SIDEBAR -->
  <aside id="sidebar" class="w-64 bg-[#1e293b] flex flex-col flex-shrink-0 shadow-2xl">
    <!-- Logo -->
    <div class="px-5 py-5 border-b border-slate-700/50">
      <a href="/innovaconta/" class="flex items-center gap-2.5">
        <span class="text-2xl">💼</span>
        <span class="font-bold text-lg text-transparent bg-clip-text bg-gradient-to-r from-indigo-400 via-violet-400 to-emerald-400">
          Innovaconta
        </span>
      </a>
      <p class="text-xs text-slate-400 mt-1 pl-9">Comercial El Sol SpA</p>
    </div>

    <!-- Empresa info -->
    <div class="mx-4 my-4 bg-slate-800/60 rounded-xl px-4 py-3 border border-slate-700/40">
      <p class="text-[10px] text-slate-400 uppercase tracking-widest mb-1">Período activo</p>
      <p class="text-sm font-semibold text-white">Ene — May 2026</p>
      <p class="text-[10px] text-emerald-400 mt-1">● 3 meses de datos cargados</p>
    </div>

    <!-- Nav -->
    <nav class="flex-1 px-3 space-y-1 overflow-y-auto">
      {[
        { id: 'dashboard', icon: '📊', label: 'Dashboard' },
        { id: 'facturas',  icon: '🧾', label: 'Facturas' },
        { id: 'libro',     icon: '📚', label: 'Libro Mayor' },
        { id: 'balance',   icon: '⚖️', label: 'Balance General' },
        { id: 'asientos',  icon: '📝', label: 'Asientos Contables' },
        { id: 'informes',  icon: '📈', label: 'Informes' },
      ].map(item => (
        <button
          data-module={item.id}
          class="nav-btn w-full flex items-center gap-3 px-3 py-2.5 rounded-xl text-sm text-slate-400 hover:text-white hover:bg-slate-700/60 transition-all duration-150 text-left"
        >
          <span class="text-base w-5 text-center">{item.icon}</span>
          <span class="font-medium">{item.label}</span>
        </button>
      ))}
    </nav>

    <!-- Footer sidebar -->
    <div class="px-4 py-4 border-t border-slate-700/50">
      <div class="flex items-center gap-3">
        <div class="w-8 h-8 rounded-full bg-indigo-600 flex items-center justify-center text-white text-xs font-bold">CU</div>
        <div>
          <p class="text-xs font-medium text-white">Contador Usuario</p>
          <p class="text-[10px] text-slate-400">Administrador</p>
        </div>
        <span class="ml-auto w-2 h-2 bg-emerald-400 rounded-full"></span>
      </div>
    </div>
  </aside>

  <!-- CONTENIDO PRINCIPAL -->
  <div class="flex-1 flex flex-col overflow-hidden">

    <!-- TOPBAR -->
    <header class="bg-white border-b border-slate-200 px-6 py-3.5 flex items-center justify-between flex-shrink-0 shadow-sm">
      <div>
        <h1 id="page-title" class="font-bold text-slate-800 text-lg">Dashboard</h1>
        <p id="page-sub" class="text-xs text-slate-400">Resumen financiero · Mayo 2026</p>
      </div>
      <div class="flex items-center gap-3">
        <span class="text-xs bg-emerald-50 text-emerald-700 border border-emerald-200 px-3 py-1.5 rounded-full font-medium">
          ✅ SII al día
        </span>
        <span class="text-xs bg-amber-50 text-amber-700 border border-amber-200 px-3 py-1.5 rounded-full font-medium">
          ⏰ F29 vence 12/06
        </span>
        <button
          id="open-innovabot"
          class="flex items-center gap-2 bg-indigo-600 hover:bg-indigo-500 text-white text-xs font-medium px-3.5 py-2 rounded-xl transition-colors"
          onclick="document.getElementById('cb-toggle').click()"
        >
          🤖 InnovaBot
        </button>
      </div>
    </header>

    <!-- MÓDULOS -->
    <main class="flex-1 overflow-y-auto p-6 space-y-6">

      <!-- ═══ MÓDULO: DASHBOARD ═══ -->
      <div id="mod-dashboard" class="module-content space-y-6">
        <!-- KPIs -->
        <div class="grid grid-cols-2 lg:grid-cols-4 gap-5">
          {[
            { icon: '💹', label: 'Ingresos del Mes', val: '$3.200.000', sub: '▲ +8.5% vs abril', subColor: 'text-emerald-600', bg: 'bg-emerald-50 border-emerald-200' },
            { icon: '💸', label: 'Gastos del Mes',   val: '$2.480.000', sub: '▲ +3.1% vs abril', subColor: 'text-rose-500',    bg: 'bg-rose-50 border-rose-200' },
            { icon: '🎯', label: 'Utilidad Neta',    val: '$493.000',   sub: 'Margen: 15.4%',    subColor: 'text-indigo-600',  bg: 'bg-indigo-50 border-indigo-200' },
            { icon: '⚠️', label: 'Doc. Pendientes', val: '3 facturas',  sub: '$3.340.000 por cobrar', subColor: 'text-amber-600', bg: 'bg-amber-50 border-amber-200' },
          ].map(k => (
            <div class={`bg-white rounded-2xl p-5 border shadow-sm`}>
              <div class="flex items-start justify-between mb-3">
                <p class="text-sm text-slate-500 font-medium">{k.label}</p>
                <span class="text-2xl">{k.icon}</span>
              </div>
              <p class="text-2xl font-bold text-slate-800">{k.val}</p>
              <p class={`text-xs mt-1 ${k.subColor} font-medium`}>{k.sub}</p>
            </div>
          ))}
        </div>

        <!-- Gráfico + Transacciones recientes -->
        <div class="grid lg:grid-cols-3 gap-5">
          <!-- Gráfico -->
          <div class="lg:col-span-2 bg-white rounded-2xl p-6 border border-slate-200 shadow-sm">
            <div class="flex items-center justify-between mb-5">
              <div>
                <h3 class="font-bold text-slate-800">Ingresos vs Gastos</h3>
                <p class="text-xs text-slate-400">Enero — Mayo 2026 (en miles de pesos)</p>
              </div>
              <div class="flex gap-3 text-xs">
                <span class="flex items-center gap-1.5 text-slate-500"><span class="w-3 h-3 rounded bg-indigo-500 inline-block"></span>Ingresos</span>
                <span class="flex items-center gap-1.5 text-slate-500"><span class="w-3 h-3 rounded bg-rose-400 inline-block"></span>Gastos</span>
              </div>
            </div>
            <canvas id="chart-main" height="200"></canvas>
          </div>

          <!-- Últimas transacciones -->
          <div class="bg-white rounded-2xl p-5 border border-slate-200 shadow-sm">
            <h3 class="font-bold text-slate-800 mb-4">Últimas Transacciones</h3>
            <div class="space-y-3">
              {[
                { desc: 'Venta — Clínica Vida',       monto: '+$689.200', color: 'text-emerald-600', date: '28/05', icon: '↗' },
                { desc: 'Pago — Importadora Asia',     monto: '-$450.000', color: 'text-rose-500',    date: '26/05', icon: '↙' },
                { desc: 'Boletas del día',             monto: '+$125.000', color: 'text-emerald-600', date: '25/05', icon: '↗' },
                { desc: 'Servicio agua/luz',           monto: '-$85.000',  color: 'text-rose-500',    date: '23/05', icon: '↙' },
                { desc: 'Venta — Empresa ABC Ltda.',   monto: '+$357.000', color: 'text-emerald-600', date: '20/05', icon: '↗' },
              ].map(tx => (
                <div class="flex items-center gap-3">
                  <span class={`w-7 h-7 rounded-full flex items-center justify-center text-xs font-bold ${tx.icon === '↗' ? 'bg-emerald-100 text-emerald-600' : 'bg-rose-100 text-rose-500'}`}>{tx.icon}</span>
                  <div class="flex-1 min-w-0">
                    <p class="text-xs font-medium text-slate-700 truncate">{tx.desc}</p>
                    <p class="text-[10px] text-slate-400">{tx.date} / 2026</p>
                  </div>
                  <span class={`text-xs font-bold ${tx.color}`}>{tx.monto}</span>
                </div>
              ))}
            </div>
          </div>
        </div>

        <!-- Estado rápido -->
        <div class="grid grid-cols-3 gap-5">
          {[
            { label: 'Liquidez Corriente', val: '4.70', desc: 'Activo Cte / Pasivo Cte · ideal > 1.5', color: 'indigo', icon: '💧' },
            { label: 'Razón de Deuda',     val: '0.42', desc: 'Pasivo / Activo · ideal < 0.50',        color: 'emerald', icon: '⚖️' },
            { label: 'Margen Neto',        val: '15.4%', desc: 'Utilidad Neta / Ventas',               color: 'violet', icon: '📊' },
          ].map(r => (
            <div class="bg-white rounded-2xl p-5 border border-slate-200 shadow-sm">
              <div class="flex items-center gap-2 mb-2">
                <span class="text-xl">{r.icon}</span>
                <p class="text-sm text-slate-500">{r.label}</p>
              </div>
              <p class={`text-3xl font-extrabold text-${r.color}-600`}>{r.val}</p>
              <p class="text-[10px] text-slate-400 mt-1">{r.desc}</p>
            </div>
          ))}
        </div>
      </div>

      <!-- ═══ MÓDULO: FACTURAS ═══ -->
      <div id="mod-facturas" class="module-content hidden space-y-5">
        <div class="flex items-center justify-between">
          <div>
            <h2 class="font-bold text-slate-800 text-xl">Gestión de Facturas</h2>
            <p class="text-sm text-slate-400">Período: Enero — Mayo 2026</p>
          </div>
          <button
            id="btn-nueva-factura"
            class="flex items-center gap-2 bg-indigo-600 hover:bg-indigo-500 text-white font-medium px-4 py-2.5 rounded-xl transition-colors text-sm shadow-lg shadow-indigo-600/20"
          >
            ＋ Nueva Factura
          </button>
        </div>

        <!-- Filtros -->
        <div class="flex gap-2 text-sm">
          {['Todas', 'Pagadas', 'Pendientes', 'Vencidas'].map((f, i) => (
            <button
              data-filter={f.toLowerCase()}
              class={`filter-btn px-4 py-2 rounded-xl font-medium transition-all ${i === 0 ? 'bg-indigo-600 text-white' : 'bg-white border border-slate-200 text-slate-500 hover:border-indigo-400 hover:text-indigo-600'}`}
            >
              {f}
            </button>
          ))}
        </div>

        <!-- Tabla -->
        <div class="bg-white rounded-2xl border border-slate-200 shadow-sm overflow-hidden">
          <table class="w-full text-sm">
            <thead class="bg-slate-50 border-b border-slate-200">
              <tr class="text-left">
                <th class="px-5 py-3.5 font-semibold text-slate-600 text-xs uppercase tracking-wide">N° Folio</th>
                <th class="px-5 py-3.5 font-semibold text-slate-600 text-xs uppercase tracking-wide">Cliente / Proveedor</th>
                <th class="px-5 py-3.5 font-semibold text-slate-600 text-xs uppercase tracking-wide">Tipo</th>
                <th class="px-5 py-3.5 font-semibold text-slate-600 text-xs uppercase tracking-wide">Monto Total</th>
                <th class="px-5 py-3.5 font-semibold text-slate-600 text-xs uppercase tracking-wide">Fecha</th>
                <th class="px-5 py-3.5 font-semibold text-slate-600 text-xs uppercase tracking-wide">Estado</th>
              </tr>
            </thead>
            <tbody id="facturas-tbody">
              {[
                { folio: 'F-0121', quien: 'Supermercado XYZ Ltda.', tipo: 'Venta',  monto: '$1.011.500', fecha: '15/01/2026', estado: 'Pagada' },
                { folio: 'F-0122', quien: 'Distribuidora Sur SpA',   tipo: 'Venta',  monto: '$619.800',   fecha: '22/01/2026', estado: 'Pagada' },
                { folio: 'F-0123', quien: 'Comercial Norte S.A.',    tipo: 'Venta',  monto: '$1.428.000', fecha: '05/02/2026', estado: 'Pagada' },
                { folio: 'F-0124', quien: 'TechStore Chile Ltda.',   tipo: 'Venta',  monto: '$809.200',   fecha: '18/02/2026', estado: 'Pagada' },
                { folio: 'F-0125', quien: 'Restaurant El Cielo SpA', tipo: 'Venta',  monto: '$511.700',   fecha: '01/03/2026', estado: 'Pagada' },
                { folio: 'F-0126', quien: 'Consultora Digital SpA',  tipo: 'Venta',  monto: '$1.130.500', fecha: '15/03/2026', estado: 'Pendiente' },
                { folio: 'C-0089', quien: 'Ferretería Central',      tipo: 'Compra', monto: '$857.680',   fecha: '28/03/2026', estado: 'Vencida' },
                { folio: 'C-0090', quien: 'Importadora Asia Ltda.',  tipo: 'Compra', monto: '$1.725.500', fecha: '10/04/2026', estado: 'Pendiente' },
                { folio: 'F-0127', quien: 'Clínica Vida SpA',        tipo: 'Venta',  monto: '$690.420',   fecha: '20/04/2026', estado: 'Pagada' },
                { folio: 'F-0128', quien: 'Hotel Pacífico Ltda.',    tipo: 'Venta',  monto: '$1.059.100', fecha: '05/05/2026', estado: 'Pendiente' },
              ].map(f => (
                <tr class="factura-row border-b border-slate-100 hover:bg-slate-50 transition-colors" data-estado={f.estado.toLowerCase()}>
                  <td class="px-5 py-3.5 font-mono text-xs text-indigo-600 font-semibold">{f.folio}</td>
                  <td class="px-5 py-3.5 font-medium text-slate-700">{f.quien}</td>
                  <td class="px-5 py-3.5">
                    <span class={`text-xs px-2.5 py-1 rounded-full font-medium ${f.tipo === 'Venta' ? 'bg-blue-100 text-blue-700' : 'bg-purple-100 text-purple-700'}`}>
                      {f.tipo}
                    </span>
                  </td>
                  <td class="px-5 py-3.5 font-semibold text-slate-800">{f.monto}</td>
                  <td class="px-5 py-3.5 text-slate-500 text-xs">{f.fecha}</td>
                  <td class="px-5 py-3.5">
                    <span class={`text-xs px-2.5 py-1.5 rounded-full font-semibold ${f.estado === 'Pagada' ? 'bg-emerald-100 text-emerald-700' : f.estado === 'Pendiente' ? 'bg-amber-100 text-amber-700' : 'bg-rose-100 text-rose-700'}`}>
                      {f.estado === 'Pagada' ? '✅' : f.estado === 'Pendiente' ? '⏳' : '🔴'} {f.estado}
                    </span>
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>

      <!-- Modal nueva factura -->
      <div id="modal-factura" class="hidden fixed inset-0 bg-slate-900/70 backdrop-blur-sm z-50 flex items-center justify-center p-4">
        <div class="bg-white rounded-2xl shadow-2xl w-full max-w-md p-6 animate-bounce-in">
          <div class="flex items-center justify-between mb-5">
            <h3 class="font-bold text-slate-800 text-lg">Nueva Factura</h3>
            <button id="close-modal" class="text-slate-400 hover:text-slate-600 text-xl font-bold">✕</button>
          </div>
          <form id="form-factura" class="space-y-4">
            <div class="grid grid-cols-2 gap-4">
              <div>
                <label class="text-xs font-semibold text-slate-600 block mb-1.5">Tipo de documento</label>
                <select class="w-full border border-slate-300 rounded-xl px-3 py-2.5 text-sm focus:outline-none focus:border-indigo-500">
                  <option>Factura Afecta</option>
                  <option>Factura Exenta</option>
                  <option>Boleta</option>
                </select>
              </div>
              <div>
                <label class="text-xs font-semibold text-slate-600 block mb-1.5">Tipo de operación</label>
                <select class="w-full border border-slate-300 rounded-xl px-3 py-2.5 text-sm focus:outline-none focus:border-indigo-500">
                  <option>Venta</option>
                  <option>Compra</option>
                </select>
              </div>
            </div>
            <div>
              <label class="text-xs font-semibold text-slate-600 block mb-1.5">RUT Emisor / Receptor</label>
              <input type="text" placeholder="Ej: 76.123.456-7" class="w-full border border-slate-300 rounded-xl px-3 py-2.5 text-sm focus:outline-none focus:border-indigo-500" />
            </div>
            <div>
              <label class="text-xs font-semibold text-slate-600 block mb-1.5">Razón Social</label>
              <input type="text" placeholder="Nombre de la empresa" class="w-full border border-slate-300 rounded-xl px-3 py-2.5 text-sm focus:outline-none focus:border-indigo-500" />
            </div>
            <div class="grid grid-cols-2 gap-4">
              <div>
                <label class="text-xs font-semibold text-slate-600 block mb-1.5">N° Folio</label>
                <input type="text" placeholder="F-0129" class="w-full border border-slate-300 rounded-xl px-3 py-2.5 text-sm focus:outline-none focus:border-indigo-500" />
              </div>
              <div>
                <label class="text-xs font-semibold text-slate-600 block mb-1.5">Fecha emisión</label>
                <input type="date" class="w-full border border-slate-300 rounded-xl px-3 py-2.5 text-sm focus:outline-none focus:border-indigo-500" />
              </div>
            </div>
            <div>
              <label class="text-xs font-semibold text-slate-600 block mb-1.5">Monto Neto ($)</label>
              <input id="monto-neto" type="number" placeholder="100000" class="w-full border border-slate-300 rounded-xl px-3 py-2.5 text-sm focus:outline-none focus:border-indigo-500" />
            </div>
            <div class="bg-indigo-50 border border-indigo-200 rounded-xl p-3 text-sm">
              <div class="flex justify-between text-slate-600">
                <span>Monto Neto:</span><span id="calc-neto">$0</span>
              </div>
              <div class="flex justify-between text-slate-600 mt-1">
                <span>IVA (19%):</span><span id="calc-iva" class="text-indigo-600">$0</span>
              </div>
              <div class="flex justify-between font-bold text-slate-800 mt-1 pt-1 border-t border-indigo-200">
                <span>Total:</span><span id="calc-total" class="text-indigo-700">$0</span>
              </div>
            </div>
            <button type="submit" class="w-full bg-indigo-600 hover:bg-indigo-500 text-white font-semibold py-3 rounded-xl transition-colors">
              ✅ Guardar Factura
            </button>
          </form>
        </div>
      </div>

      <!-- ═══ MÓDULO: LIBRO MAYOR ═══ -->
      <div id="mod-libro" class="module-content hidden space-y-5">
        <div>
          <h2 class="font-bold text-slate-800 text-xl">Libro Mayor</h2>
          <p class="text-sm text-slate-400">Movimientos por cuenta contable · Mayo 2026</p>
        </div>

        <div class="flex items-center gap-4">
          <label class="text-sm font-medium text-slate-600">Seleccionar cuenta:</label>
          <select id="cuenta-selector" class="border border-slate-300 rounded-xl px-4 py-2.5 text-sm focus:outline-none focus:border-indigo-500 bg-white shadow-sm">
            <option value="caja">1101 — Caja</option>
            <option value="banco">1102 — Banco BCI</option>
            <option value="cxc">1103 — Cuentas por Cobrar</option>
            <option value="inventario">1104 — Inventario</option>
            <option value="cxp">2101 — Cuentas por Pagar</option>
            <option value="iva_debito">2102 — IVA Débito Fiscal</option>
            <option value="ventas">4101 — Ingresos por Ventas</option>
            <option value="gasto_rem">5201 — Gasto en Remuneraciones</option>
          </select>
        </div>

        <div class="bg-white rounded-2xl border border-slate-200 shadow-sm overflow-hidden">
          <div class="px-5 py-4 border-b border-slate-200 flex justify-between items-center">
            <div>
              <h3 id="cuenta-nombre" class="font-bold text-slate-800">1101 — Caja</h3>
              <p class="text-xs text-slate-400">Activo Corriente</p>
            </div>
            <div id="cuenta-saldo" class="text-right">
              <p class="text-xs text-slate-400">Saldo actual</p>
              <p class="font-bold text-emerald-600 text-lg">$1.250.000</p>
            </div>
          </div>
          <table class="w-full text-sm">
            <thead class="bg-slate-50 border-b border-slate-200">
              <tr class="text-left">
                <th class="px-5 py-3 font-semibold text-slate-600 text-xs uppercase tracking-wide">Fecha</th>
                <th class="px-5 py-3 font-semibold text-slate-600 text-xs uppercase tracking-wide">Descripción</th>
                <th class="px-5 py-3 font-semibold text-slate-600 text-xs uppercase tracking-wide text-right">Debe</th>
                <th class="px-5 py-3 font-semibold text-slate-600 text-xs uppercase tracking-wide text-right">Haber</th>
                <th class="px-5 py-3 font-semibold text-slate-600 text-xs uppercase tracking-wide text-right">Saldo</th>
              </tr>
            </thead>
            <tbody id="mayor-tbody">
              <!-- Se llena con JS -->
            </tbody>
            <tfoot class="bg-slate-50 border-t border-slate-200">
              <tr>
                <td colspan="2" class="px-5 py-3 font-semibold text-slate-700 text-sm">TOTALES</td>
                <td id="total-debe" class="px-5 py-3 font-bold text-emerald-600 text-right text-sm"></td>
                <td id="total-haber" class="px-5 py-3 font-bold text-rose-500 text-right text-sm"></td>
                <td id="saldo-final" class="px-5 py-3 font-bold text-indigo-600 text-right text-sm"></td>
              </tr>
            </tfoot>
          </table>
        </div>
      </div>

      <!-- ═══ MÓDULO: BALANCE GENERAL ═══ -->
      <div id="mod-balance" class="module-content hidden space-y-5">
        <div class="flex items-center justify-between">
          <div>
            <h2 class="font-bold text-slate-800 text-xl">Balance General</h2>
            <p class="text-sm text-slate-400">Estado de Situación Financiera al 31 de Mayo de 2026</p>
          </div>
          <span class="bg-emerald-100 text-emerald-700 border border-emerald-200 px-3 py-1.5 rounded-full text-xs font-semibold">
            ✅ Cuadrado
          </span>
        </div>

        <div class="grid lg:grid-cols-3 gap-5">
          <!-- ACTIVOS -->
          <div class="lg:col-span-2 space-y-4">
            <div class="bg-white rounded-2xl border border-slate-200 shadow-sm overflow-hidden">
              <div class="bg-blue-600 px-5 py-3">
