    }
  ];

  /* ─── Helpers ─── */
  function norm(t) {
    return t.toLowerCase().normalize('NFD').replace(/[̀-ͯ]/g, '').trim();
  }

  function md(text) {
    return text
      .replace(/\*\*(.*?)\*\*/g, '<strong>$1</strong>')
      .replace(/_(.*?)_/g, '<em>$1</em>')
      .replace(/\n/g, '<br>');
  }

  function findEntry(text) {
    const n = norm(text);
    for (const e of KB) {
      for (const p of e.p) {
        if (p.startsWith('__ctx_')) continue;
        if (n.includes(norm(p))) return e;
      }
    }
    return null;
  }

  function findCtx(section) {
    return KB.find(e => e.p.includes(`__ctx_${section}__`)) || null;
  }

  /* ─── DOM refs ─── */
  const widget   = document.getElementById('cb-widget');
  const win      = document.getElementById('cb-window');
  const msgs     = document.getElementById('cb-messages');
  const qrBox    = document.getElementById('cb-qr');
  const input    = document.getElementById('cb-input');
  const sendBtn  = document.getElementById('cb-send');
  const toggle   = document.getElementById('cb-toggle');
  const closeBtn = document.getElementById('cb-close');
  const badge    = document.getElementById('cb-badge');
  const ring     = document.getElementById('cb-ring');
  const iconOpen = document.getElementById('cb-icon-open');
  const iconCls  = document.getElementById('cb-icon-close');

  if (!widget || !win || !msgs) return;

  /* ─── State ─── */
  let isOpen = false;
  let greeted = false;

  /* ─── UI builders ─── */
  function addMsg(text, from = 'bot') {
    const wrap = document.createElement('div');
    wrap.className = `flex ${from === 'bot' ? 'justify-start' : 'justify-end'} animate-fade-up`;

    const bubble = document.createElement('div');
    if (from === 'bot') {
      bubble.className = 'max-w-[78%] bg-slate-800 text-slate-100 rounded-2xl rounded-tl-sm px-3 py-2.5 text-[13px] leading-relaxed bot-message';
      bubble.innerHTML = md(text);
    } else {
      bubble.className = 'max-w-[78%] bg-indigo-600 text-white rounded-2xl rounded-tr-sm px-3 py-2.5 text-[13px]';
      bubble.textContent = text;
    }

    wrap.appendChild(bubble);
    msgs.appendChild(wrap);
    msgs.scrollTop = msgs.scrollHeight;
  }

  function showTyping() {
    const d = document.createElement('div');
    d.id = 'cb-typing';
    d.className = 'flex justify-start animate-fade-up';
    d.innerHTML = '<div class="bg-slate-800 rounded-2xl rounded-tl-sm px-4 py-3 flex items-center gap-1">' +
      '<span class="typing-dot w-2 h-2 bg-slate-400 rounded-full"></span>' +
      '<span class="typing-dot w-2 h-2 bg-slate-400 rounded-full"></span>' +
      '<span class="typing-dot w-2 h-2 bg-slate-400 rounded-full"></span>' +
      '</div>';
    msgs.appendChild(d);
    msgs.scrollTop = msgs.scrollHeight;
  }

  function removeTyping() {
    const t = document.getElementById('cb-typing');
    if (t) t.remove();
  }

  function setQR(replies) {
    qrBox.innerHTML = '';
    (replies || []).forEach(r => {
      const btn = document.createElement('button');
      btn.textContent = r;
      btn.className = 'text-[11px] bg-slate-800 hover:bg-indigo-600/30 border border-slate-600 hover:border-indigo-500 text-slate-300 hover:text-white rounded-full px-3 py-1.5 transition-all duration-200';
      btn.onclick = () => handleMsg(r);
      qrBox.appendChild(btn);
    });
  }

  async function handleMsg(text) {
    if (!text.trim()) return;
    if (input) input.value = '';
    addMsg(text, 'user');
    setQR([]);
    showTyping();

    await new Promise(r => setTimeout(r, 700 + Math.random() * 500));
    removeTyping();

    const entry = findEntry(text);
    if (entry) {
      addMsg(entry.r, 'bot');
      setQR(entry.qr);
    } else {
      addMsg('Hmm, no tengo respuesta específica para eso 🤔\n\nPuedo ayudarte con:\n• Conceptos contables (balance, asientos, IVA...)\n• Cómo usar los módulos de Innovaconta\n• Procedimientos tributarios en Chile\n\n¿Puedes reformular tu pregunta?', 'bot');
      setQR(['¿Qué es el balance?', '¿Qué es el IVA?', '¿Cómo uso Innovaconta?']);
    }
  }

  /* ─── Open / Close ─── */
  function openChat() {
    isOpen = true;
    win.classList.remove('hidden');
    win.classList.add('animate-slide-up');
    iconOpen.classList.add('hidden');
    iconCls.classList.remove('hidden');
    badge.classList.add('hidden');
    ring.classList.add('hidden');

    if (!greeted) {
      greeted = true;
      setTimeout(() => {
        addMsg('¡Hola! 👋 Soy **InnovaBot**, tu asistente de contabilidad con IA.\n\nEstoy aquí para explicarte conceptos contables y ayudarte a usar Innovaconta. ¿En qué puedo ayudarte?', 'bot');
        setQR(['¿Qué es el balance general?', '¿Qué es el IVA?', '¿Cómo funciona Innovaconta?']);
      }, 250);
    }
  }

  function closeChat() {
    isOpen = false;
    win.classList.add('hidden');
    iconOpen.classList.remove('hidden');
    iconCls.classList.add('hidden');
  }

  /* ─── Events ─── */
  toggle.addEventListener('click', () => isOpen ? closeChat() : openChat());
  closeBtn.addEventListener('click', closeChat);
  sendBtn.addEventListener('click', () => handleMsg(input.value));
  input.addEventListener('keydown', e => { if (e.key === 'Enter') handleMsg(input.value); });

  // Escucha eventos de contexto del dashboard
  window.addEventListener('innovabot:context', e => {
    const section = e.detail && e.detail.section;
    if (!section) return;
    const entry = findCtx(section);
    if (!entry) return;

    if (isOpen) {
      setTimeout(() => { addMsg(entry.r, 'bot'); setQR(entry.qr); }, 400);
    } else {
      badge.classList.remove('hidden');
      ring.classList.remove('hidden');
    }
  });

  // Mostrar badge después de 2 s si no se ha abierto aún
  setTimeout(() => {
    if (!greeted) {
      badge.classList.remove('hidden');
      ring.classList.remove('hidden');
    }
  }, 2000);
})();
</script>
